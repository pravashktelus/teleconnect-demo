# Copy to .env for local dev, or set these in the Vercel dashboard (Project Settings -> Environment Variables).

# Postgres connection string.
# Local example (Postgres running on localhost):
#   postgresql://postgres:postgres@localhost:5432/teleconnect?schema=public
# On Vercel: use the connection string from your Postgres provider (Vercel Postgres / Prisma Postgres / Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET="change-me-to-a-long-random-string"
